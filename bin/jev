#!/bin/sh
# Runs jevkit from this checkout with whatever python3 is on PATH. No install step, no dependencies.
here="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
# On Windows a shell path like /c/Users/... is not understood by a native Python, and
# PYTHONPATH separates with ';' there rather than ':', so a prepended entry made the whole
# variable unparseable and `jev` only worked when the checkout happened to be the cwd.
# Running from the checkout puts jevkit on sys.path without path translation.
cd "$here" || exit 1
exec python3 -m jevkit "$@"
